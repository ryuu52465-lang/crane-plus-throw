<?xml version="1.0" ?>
<!-- 書籍のtable.sdfをベースに、投げるボールと的の箱を追加したワールド -->
<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 机の真上0.6mから真下を見るカメラ。画像の上がワールド+x、右がワールド-y になる -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.17 0 1.615 0 1.5708 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.05</near><far>3.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/overhead_camera/image</topic>
        </sensor>
      </link>
    </model>

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Ground%20Plane
      </uri>
    </include>

    <include>
      <uri>
        https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Table
      </uri>
      <pose>0.29 0 0 0 0 1.5708</pose>
    </include>

    <!-- 机の縁の柵(高さ3cm)。外れたボールが床まで転がっていくのを防ぐ
         机の天板は x=-0.11〜0.69, y=-0.75〜0.75 -->
    <model name="fence">
      <static>true</static>
      <pose>0.29 0 1.015 0 0 0</pose>
      <link name="link">
        <collision name="xp_c"><pose>0.39 0 0.015 0 0 0</pose>
          <geometry><box><size>0.01 1.5 0.03</size></box></geometry></collision>
        <visual name="xp_v"><pose>0.39 0 0.015 0 0 0</pose>
          <geometry><box><size>0.01 1.5 0.03</size></box></geometry></visual>
        <!-- ロボットの後ろ側(x=-0.10)には置かない。振りかぶったアームが当たるため -->
        <collision name="yp_c"><pose>0 0.74 0.015 0 0 0</pose>
          <geometry><box><size>0.8 0.01 0.03</size></box></geometry></collision>
        <visual name="yp_v"><pose>0 0.74 0.015 0 0 0</pose>
          <geometry><box><size>0.8 0.01 0.03</size></box></geometry></visual>
        <collision name="ym_c"><pose>0 -0.74 0.015 0 0 0</pose>
          <geometry><box><size>0.8 0.01 0.03</size></box></geometry></collision>
        <visual name="ym_v"><pose>0 -0.74 0.015 0 0 0</pose>
          <geometry><box><size>0.8 0.01 0.03</size></box></geometry></visual>
      </link>
    </model>

    <!-- 投げるボール(直径4cm, 20g)。ロボット(z=1.015)の右前に置く -->
    <model name="ball">
      <pose>0.05 -0.13 1.035 0 0 0</pose>
      <!-- 正解データ用: ボールのワールド座標と速度を /model/ball/odometry に出す -->
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_frame>world</odom_frame>
        <robot_base_frame>ball</robot_base_frame>
        <odom_topic>/model/ball/odometry</odom_topic>
        <odom_publish_frequency>100</odom_publish_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.02</mass>
          <inertia>
            <ixx>3.2e-6</ixx><iyy>3.2e-6</iyy><izz>3.2e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <!-- ロボット(0x01)とは当たらず、机・箱・柵・床(既定0xffff)とは当たる -->
            <contact><collide_bitmask>0x02</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material>
            <ambient>1.0 0.45 0.0 1</ambient>
            <diffuse>1.0 0.45 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 的の箱(内寸8cm角, 高さ4cm, 上が開いている) -->
    <model name="target_box">
      <static>true</static>
      <pose>0.30 0 1.015 0 0 0</pose>
      <link name="link">
        <collision name="bottom_c">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.09 0.09 0.005</size></box></geometry>
        </collision>
        <visual name="bottom_v">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.09 0.09 0.005</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_xp_c">
          <pose>0.0425 0 0.02 0 0 0</pose>
          <geometry><box><size>0.005 0.09 0.04</size></box></geometry>
        </collision>
        <visual name="wall_xp_v">
          <pose>0.0425 0 0.02 0 0 0</pose>
          <geometry><box><size>0.005 0.09 0.04</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_xm_c">
          <pose>-0.0425 0 0.02 0 0 0</pose>
          <geometry><box><size>0.005 0.09 0.04</size></box></geometry>
        </collision>
        <visual name="wall_xm_v">
          <pose>-0.0425 0 0.02 0 0 0</pose>
          <geometry><box><size>0.005 0.09 0.04</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_yp_c">
          <pose>0 0.0425 0.02 0 0 0</pose>
          <geometry><box><size>0.09 0.005 0.04</size></box></geometry>
        </collision>
        <visual name="wall_yp_v">
          <pose>0 0.0425 0.02 0 0 0</pose>
          <geometry><box><size>0.09 0.005 0.04</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
        <collision name="wall_ym_c">
          <pose>0 -0.0425 0.02 0 0 0</pose>
          <geometry><box><size>0.09 0.005 0.04</size></box></geometry>
        </collision>
        <visual name="wall_ym_v">
          <pose>0 -0.0425 0.02 0 0 0</pose>
          <geometry><box><size>0.09 0.005 0.04</size></box></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
